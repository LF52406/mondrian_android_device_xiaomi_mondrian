# PreferenceFragment is created by class name when restored after a density change.
-keep public class org.lineageos.mondrian.display.ResolutionFragment {
    public <init>();
}

# Custom Preference classes are inflated by name from screen_resolution.xml.
-keep public class org.lineageos.mondrian.display.ResolutionCardsPreference {
    public <init>(android.content.Context, android.util.AttributeSet);
}

-keep public class org.lineageos.mondrian.display.PartialUpdatePreference {
    public <init>(android.content.Context, android.util.AttributeSet);
}
