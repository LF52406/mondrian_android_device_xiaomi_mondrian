android_app {
    name: "MondrianDisplaySettings",
    defaults: ["SettingsLibDefaults", "platform_app_defaults"],
    srcs: ["src/**/*.java"],
    resource_dirs: ["res"],
    certificate: "platform",
    platform_apis: true,
    system_ext_specific: true,
    privileged: true,
    static_libs: ["org.lineageos.settings.resources"],
    required: [
        "init.mondrian.display.rc",
        "privapp-permissions-mondrian-display.xml",
    ],
    optimize: {
        proguard_flags_files: ["proguard.flags"],
    },
}

prebuilt_etc {
    name: "init.mondrian.display.rc",
    src: "init.mondrian.display.rc",
    filename: "init.mondrian.display.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

prebuilt_etc {
    name: "privapp-permissions-mondrian-display.xml",
    src: "permissions/privapp-permissions-mondrian-display.xml",
    sub_dir: "permissions",
    system_ext_specific: true,
}
