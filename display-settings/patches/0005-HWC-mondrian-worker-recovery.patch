+
+  // Never write kernel profile 0 until the compositor has produced and
+  // retired a full-frame commit with ROI composition disabled.
+  if (!MondrianCommitPartialUpdate(false)) {
+    DLOGE("Mondrian: full-frame HWC retirement failed for profile %d", profile);
+    return false;
+  }
   if (ReadProperty(kRequest) != request || mondrian_stop_) return false;
 
-  if (!ProgramKernelProfile(request, profile)) return false;
