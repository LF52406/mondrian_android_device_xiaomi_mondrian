+void BootAnimation::processDisplayEvents() {
+    ATRACE_CALL();
+    // This will poll mDisplayEventReceiver and if there are new events it'll call
+    // displayEventCallback synchronously.
+    mLooper->pollOnce(0);
+    updateLogicalDisplayGeometry();
+}
+
+void BootAnimation::updateLogicalDisplayGeometry() {
+    ATRACE_CALL();
+    if (!mFollowLogicalDisplayGeometry || mShuttingDown || mDisplays.empty()) {
+        return;
+    }
+
+    const int64_t now = elapsedRealtime();
+    if (mLastLogicalGeometryCheckMs >= 0
+            && now - mLastLogicalGeometryCheckMs < LOGICAL_GEOMETRY_POLL_INTERVAL_MS) {
+        return;
+    }
+    mLastLogicalGeometryCheckMs = now;
+
+    auto& display = mDisplays.front();
+    ui::DisplayState displayState;
+    const status_t error =
+            SurfaceComposerClient::getDisplayState(display.displayToken, &displayState);
+    if (error != NO_ERROR) {
+        SLOGV("mondrian: failed to query logical display geometry: %d", error);
+        return;
+    }
+
+    // WindowManager's forced size is represented by SurfaceFlinger's layer-stack space.
+    // Follow only the two geometries exposed by MondrianDisplaySettings. Ignore transient
+    // projections, rotation and any unexpected state rather than changing the display itself.
+    if (displayState.orientation != ui::ROTATION_0) {
+        return;
+    }
+    const int logicalWidth = displayState.layerStackSpaceRect.width;
+    const int logicalHeight = displayState.layerStackSpaceRect.height;
+    const bool supportedGeometry =
+            (logicalWidth == MONDRIAN_FHD_WIDTH && logicalHeight == MONDRIAN_FHD_HEIGHT)
+            || (logicalWidth == MONDRIAN_WQHD_WIDTH && logicalHeight == MONDRIAN_WQHD_HEIGHT);
+    if (!supportedGeometry || (logicalWidth == display.width && logicalHeight == display.height)) {
+        return;
+    }
+
+    SLOGI("mondrian: boot animation logical geometry %dx%d -> %dx%d", display.width,
+          display.height, logicalWidth, logicalHeight);
+    resizeSurface(logicalWidth, logicalHeight, display);
+}
 
