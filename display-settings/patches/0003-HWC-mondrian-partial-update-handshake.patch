diff --git a/sdm/include/utils/locker.h b/sdm/include/utils/locker.h
index 4b3f3c6..f21545d 100644
--- a/sdm/include/utils/locker.h
+++ b/sdm/include/utils/locker.h
@@ -100,6 +100,28 @@ class Locker {
       locker_.Unlock();
     }
 
+    // Bounded clients must not wait forever for a validate/present sequence
+    // abandoned by a disconnected composer client. Existing callers are unchanged.
+    SequenceWaitScopeLock(Locker& locker, uint32_t timeout_ms)
+        : locker_(locker), error_(false) {
+      locker_.Lock();
+      struct timespec deadline;
+      if (clock_gettime(CLOCK_MONOTONIC, &deadline)) {
+        error_ = true;
+        return;
+      }
+      uint64_t ns = static_cast<uint64_t>(deadline.tv_nsec) + timeout_ms * 1000000ULL;
+      deadline.tv_sec += static_cast<time_t>(ns / 1000000000ULL);
+      deadline.tv_nsec = ns % 1000000000ULL;
+      while (locker_.sequence_wait_ == 1) {
+        if (pthread_cond_timedwait(&locker_.condition_, &locker_.mutex_, &deadline)) {
+          error_ = true;
+          break;
+        }
+        error_ = (locker_.sequence_wait_ == -1);
+      }
+    }
+
     bool IsError() {
       return error_;
     }
@@ -176,4 +198,3 @@ class Locker {
 }  // namespace sdm
 
 #endif  // __LOCKER_H__
