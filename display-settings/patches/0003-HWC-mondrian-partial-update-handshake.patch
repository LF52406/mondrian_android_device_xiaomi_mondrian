diff --git a/composer/hwc_mondrian.cpp b/composer/hwc_mondrian.cpp
new file mode 100644
index 0000000..9dfdf4c
--- /dev/null
+++ b/composer/hwc_mondrian.cpp
@@ -0,0 +1,144 @@
+/* Copyright (C) 2026 The LineageOS Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+#include "hwc_session.h"
+
+#include <cutils/properties.h>
+#include <chrono>
+#include <fstream>
+#include <thread>
+
+namespace sdm {
+namespace {
+constexpr char kRequest[] = "vendor.mondrian.display.request";
+constexpr char kStatus[] = "vendor.mondrian.display.status";
+constexpr char kAllowed[] = "vendor.mondrian.display.pu_allowed";
+constexpr char kProfile[] = "vendor.mondrian.display.profile";
+constexpr char kSerial[] = "vendor.mondrian.display.profile_serial";
+constexpr char kApplied[] = "vendor.mondrian.display.profile_applied";
+constexpr char kProfilePath[] = "/sys/module/msm_drm/parameters/m11a_partial_update_profile";
+
+std::string ReadProperty(const char *name) {
+  char value[PROPERTY_VALUE_MAX] = {};
+  property_get(name, value, "");
+  return value;
+}
+
+bool IsRequest(const std::string &request) {
+  if (request.size() != 38 || request[36] != ':' ||
+      (request[37] != '0' && request[37] != '1')) return false;
+  for (size_t i = 0; i < 36; ++i) {
+    if (i == 8 || i == 13 || i == 18 || i == 23) {
+      if (request[i] != '-') return false;
+    } else if (!((request[i] >= '0' && request[i] <= '9') ||
+                 (request[i] >= 'a' && request[i] <= 'f'))) {
+      return false;
+    }
+  }
+  return true;
+}
+
+bool ProfileApplied(const std::string &request) {
+  if (ReadProperty(kApplied) != request) return false;
+  int actual = -1;
+  std::ifstream stream(kProfilePath);
+  return (stream >> actual) && actual == request.back() - '0';
+}
+
+bool SetProfile(const std::string &request, int profile) {
+  // One outstanding init action at a time. Even after a timeout, drain its exact
+  // acknowledgement before another action can be queued. A late old ON write
+  // must never follow an acknowledged OFF.
+  static std::string pending = [] {
+    const std::string old = ReadProperty(kSerial) + ":" + ReadProperty(kProfile);
+    return IsRequest(old) ? old : std::string();
+  }();
+  if (!pending.empty()) {
+    if (ReadProperty(kApplied) != pending) return false;
+    pending.clear();
+  }
+  if (ReadProperty(kRequest) != request) return false;
+  pending = request;
+  if (property_set(kSerial, request.substr(0, 36).c_str()) ||
+      property_set(kProfile, "") || property_set(kProfile, profile ? "1" : "0")) return false;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(600);
+  do {
+    if (ReadProperty(kApplied) == request) {
+      pending.clear();
+      return ProfileApplied(request) && ReadProperty(kRequest) == request;
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(10));
+  } while (std::chrono::steady_clock::now() < deadline);
+  return false;
+}
+}  // namespace
+
+void HWCSession::StartMondrianPartialUpdate() {
+  if (!property_get_bool("ro.vendor.mondrian.display_control", false)) return;
+  mondrian_stop_ = false;
+  mondrian_thread_ = std::thread([this] {
+    // Do not replay an old ON request after composer restarts. The owner must reconcile.
+    std::string previous = ReadProperty(kRequest);
+    property_set(kStatus, "offline");
+    while (!mondrian_stop_) {
+      const std::string request = ReadProperty(kRequest);
+      if (request != previous && IsRequest(request)) {
+        previous = request;
+        const bool enable = request.back() == '1';
+        // Disable composition first. Expanding only the DSI ROI would be unsafe.
+        bool ok = property_set(kAllowed, "0") == 0 && MondrianCommit(false);
+        if (ok) ok = SetProfile(request, enable ? 1 : 0);
+        if (ok && enable && ReadProperty(kRequest) == request) {
+          ok = property_set(kAllowed, "1") == 0 && MondrianCommit(true);
+        }
+        if (ReadProperty(kRequest) != request) {
+          property_set(kAllowed, "0");
+          continue;
+        }
+        if (!ok) {
+          // Never enable from an unacknowledged request. Leave kernel geometry alone
+          // until a later OFF request has retired a valid full composition.
+          property_set(kAllowed, "0");
+        }
+        property_set(kStatus, (request + (ok ? ":ok" : ":error")).c_str());
+      }
+      // Idle request polling only; no display operation is acknowledged by elapsed time.
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    }
+  });
+}
+
+void HWCSession::StopMondrianPartialUpdate() {
+  mondrian_stop_ = true;
+  if (mondrian_thread_.joinable()) mondrian_thread_.join();
+}
+
+bool HWCSession::MondrianCommit(bool enable) {
+  std::shared_ptr<Fence> fence;
+  {
+    Locker::SequenceWaitScopeLock lock(locker_[HWC_DISPLAY_PRIMARY], 1200);
+    if (lock.IsError() || mondrian_stop_) return false;
+    auto *display = hwc_display_[HWC_DISPLAY_PRIMARY];
+    if (!display || pending_power_mode_[HWC_DISPLAY_PRIMARY]) return false;
+    uint32_t pending = 0;
+    if (display->ControlPartialUpdate(enable, &pending) != kErrorNone ||
+        display->InvalidateForMondrianPartialUpdate() != kErrorNone) return false;
+    // A new validate is required even when false -> false would be a no-op.
+    mondrian_fence_ = nullptr;
+    mondrian_waiting_ = true;
+    callbacks_.Refresh(HWC_DISPLAY_PRIMARY);
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::milliseconds(1200);
+    while (mondrian_waiting_ && !mondrian_stop_) {
+      auto remaining = std::chrono::duration_cast<std::chrono::milliseconds>(
+          deadline - std::chrono::steady_clock::now()).count();
+      if (remaining <= 0) break;
+      locker_[HWC_DISPLAY_PRIMARY].WaitFinite(static_cast<uint32_t>(remaining));
+    }
+    mondrian_waiting_ = false;
+    fence = mondrian_fence_;
+    mondrian_fence_ = nullptr;
+  }
+  // A skipped present, power transition or null fence is not proof of a frame.
+  return fence && !mondrian_stop_ && Fence::Wait(fence, 400) == 0;
+}
+}  // namespace sdm
