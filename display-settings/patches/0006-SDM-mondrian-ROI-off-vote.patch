+// The M11A OFF setting must not be overridden by internal Qualcomm paths,
+// including color sampling, video-to-command transitions and DPPS callbacks.
+// The property is an immediate HWC policy vote; the kernel readback covers a
+// composer crash/restart before the property has been initialized.
+static bool MondrianRoiMustStayOff() {
+  char allow[PROP_VALUE_MAX] = {};
+  __system_property_get("vendor.mondrian.display.roi_allowed", allow);
+  if (std::strcmp(allow, "0") == 0) return true;
+
+  std::ifstream profile("/sys/module/msm_drm/parameters/m11a_partial_update_profile");
+  int value = -1;
+  return static_cast<bool>(profile >> value) && value == 0;
+}
