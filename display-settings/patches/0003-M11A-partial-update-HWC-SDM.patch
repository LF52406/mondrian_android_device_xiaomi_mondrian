+// SPDX-License-Identifier: Apache-2.0
+// Copyright (C) 2026
+#ifndef __MONDRIAN_PU_H__
+#define __MONDRIAN_PU_H__
+
+#include <cstring>
+#include <private/hw_info_types.h>
+#include <utils/debug.h>
+#include "mondrian_pu_geometry.h"
+
+namespace sdm {
+namespace mondrian_pu {
+
+constexpr const char *kModeProperty = "persist.sys.mondrian.partial_update";
+
+inline bool IsPanel(const HWPanelInfo &panel) {
+  return panel.is_primary_panel && panel.mode == kModeCommand &&
+         !std::strcmp(panel.panel_name, "xiaomi 42 02 0a cmd mode dsc dsi panel");
+}
+
+// 0: full frame; 2: DSC-aligned rectangles. Legacy mode 1 is promoted to 2.
+inline int Mode(const HWPanelInfo &panel) {
+  if (!IsPanel(panel)) {
+    return -1;
+  }
+  int mode = 2;
+  Debug::GetProperty(kModeProperty, &mode);
+  return mode == 0 ? 0 : 2;
+}
+
+inline bool PlannerPanelInfo(const HWPanelInfo &panel, const HWMixerAttributes &mixer,
+                            const HWDisplayAttributes &display, HWPanelInfo *out) {
+  *out = panel;
+  if (!IsPanel(panel)) {
+    return false;
+  }
+  if (!panel.partial_update || display.x_pixels != 1440 || display.y_pixels != 3200 ||
+      !mixer.width || !mixer.height) {
+    out->partial_update = false;
+    return false;
+  }
+  // libsdmextension::ApplyPanelRestriction maps mixer -> panel, aligns there,
+  // then maps back. ConfigureDestScaleData also consumes physical constraints.
+  // Passing 540x24 for FHD+ here would apply the scale twice. Check that an
+  // exact source grid exists, but keep the advertised physical 720x32 grid.
+  int left_align, width_align, top_align, height_align, min_width, min_height;
+  const bool valid =
+      SourceAlignment(panel.left_align, mixer.width, display.x_pixels, &left_align) &&
+      SourceAlignment(panel.width_align, mixer.width, display.x_pixels, &width_align) &&
+      SourceMinimum(panel.min_roi_width, mixer.width, display.x_pixels,
+                    width_align, &min_width) &&
+      SourceAlignment(panel.top_align, mixer.height, display.y_pixels, &top_align) &&
+      SourceAlignment(panel.height_align, mixer.height, display.y_pixels, &height_align) &&
+      SourceMinimum(panel.min_roi_height, mixer.height, display.y_pixels,
+                    height_align, &min_height);
+  out->partial_update = valid;
+  return valid;
+}
+
+}  // namespace mondrian_pu
+}  // namespace sdm
+#endif
