+// SPDX-License-Identifier: Apache-2.0
+// Copyright (C) 2026
+#ifndef __MONDRIAN_PU_H__
+#define __MONDRIAN_PU_H__
+
+#include <cstring>
+#include <private/hw_info_types.h>
+#include <utils/debug.h>
+#include "mondrian_pu_geometry.h"
+
+namespace sdm {
+namespace mondrian_pu {
+
+constexpr const char *kModeProperty = "persist.sys.mondrian.partial_update";
+
+inline bool IsPanel(const HWPanelInfo &panel) {
+  return panel.is_primary_panel && panel.mode == kModeCommand &&
+         !std::strcmp(panel.panel_name, "xiaomi 42 02 0a cmd mode dsc dsi panel");
+}
+
+// 0: full frame; 2: DSC-aligned rectangles. Legacy mode 1 is promoted to 2.
+inline int Mode(const HWPanelInfo &panel) {
+  if (!IsPanel(panel)) {
+    return -1;
+  }
+  int mode = 2;
+  Debug::GetProperty(kModeProperty, &mode);
+  return mode == 0 ? 0 : 2;
+}
+
+inline bool MapConstraints(const HWPanelInfo &panel, const HWMixerAttributes &mixer,
+                            const HWDisplayAttributes &display, int mode, HWPanelInfo *out) {
+  *out = panel;
+  if (!IsPanel(panel)) {
+    return false;
+  }
+  if (!panel.partial_update || display.x_pixels != 1440 || display.y_pixels != 3200 ||
+      !mixer.width || !mixer.height || mode != 2) {
+    out->partial_update = false;
+    return false;
+  }
+  const HWPanelInfo physical = *out;
+  const bool valid =
+      SourceAlignment(physical.left_align, mixer.width, display.x_pixels, &out->left_align) &&
+      SourceAlignment(physical.width_align, mixer.width, display.x_pixels, &out->width_align) &&
+      SourceMinimum(physical.min_roi_width, mixer.width, display.x_pixels,
+                    out->width_align, &out->min_roi_width) &&
+      SourceAlignment(physical.top_align, mixer.height, display.y_pixels, &out->top_align) &&
+      SourceAlignment(physical.height_align, mixer.height, display.y_pixels, &out->height_align) &&
+      SourceMinimum(physical.min_roi_height, mixer.height, display.y_pixels,
+                    out->height_align, &out->min_roi_height);
+  out->partial_update = valid;
+  return valid;
+}
+
+}  // namespace mondrian_pu
+}  // namespace sdm
+#endif
