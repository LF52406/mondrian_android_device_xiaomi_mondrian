--- /dev/null
+++ b/sdm/libs/core/mondrian_pu_geometry.h
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (C) 2026
+#ifndef __MONDRIAN_PU_GEOMETRY_H__
+#define __MONDRIAN_PU_GEOMETRY_H__
+
+#include <cstdint>
+
+namespace sdm {
+namespace mondrian_pu {
+
+// All coordinates here are exclusive right/bottom edges, never DCS end addresses.
+inline uint64_t Gcd(uint64_t a, uint64_t b) {
+  while (b) {
+    const uint64_t next = a % b;
+    a = b;
+    b = next;
+  }
+  return a;
+}
+
+// Smallest source grid whose projection is integral and aligned on the panel.
+// FHD+ examples: 720 panel columns -> 540 mixer columns; 32 rows -> 24 rows.
+inline bool SourceAlignment(uint32_t alignment, uint32_t source, uint32_t panel,
+                            int *result) {
+  if (!alignment || !source || !panel || source > 65535 || panel > 65535 || !result) {
+    return false;
+  }
+  const uint64_t numerator = uint64_t(alignment) * source;
+  const uint64_t step = numerator / Gcd(numerator, panel);
+  if (!step || step > source || source % step) {
+    return false;
+  }
+  *result = int(step);
+  return true;
+}
+
+inline bool SourceMinimum(uint32_t minimum, uint32_t source, uint32_t panel,
+                          uint32_t alignment, int *result) {
+  if (!minimum || !source || !panel || !alignment || !result) {
+    return false;
+  }
+  uint64_t value = (uint64_t(minimum) * source + panel - 1) / panel;
+  value = (value + alignment - 1) / alignment * alignment;
+  if (!value || value > source || value > 65535) {
+    return false;
+  }
+  *result = int(value);
+  return true;
+}
+
+// A late expansion would disagree with the already prepared scaler/DSC stream.
+// Accept only an exact mapping. Unsupported plans are retried as full frames.
+inline bool ProjectAxis(uint32_t start, uint32_t end, uint32_t source, uint32_t panel,
+                        uint32_t start_alignment, uint32_t size_alignment,
+                        uint32_t minimum, uint32_t *out_start, uint32_t *out_end) {
+  if (!source || !panel || source > 65535 || panel > 65535 || start >= end ||
+      end > source || !start_alignment || !size_alignment || !minimum ||
+      !out_start || !out_end) {
+    return false;
+  }
+  const uint64_t first = uint64_t(start) * panel;
+  const uint64_t last = uint64_t(end) * panel;
+  if (first % source || last % source) {
+    return false;
+  }
+  const uint32_t left = uint32_t(first / source);
+  const uint32_t right = uint32_t(last / source);
+  if (left % start_alignment || (right - left) % size_alignment || right - left < minimum) {
+    return false;
+  }
+  *out_start = left;
+  *out_end = right;
+  return true;
+}
