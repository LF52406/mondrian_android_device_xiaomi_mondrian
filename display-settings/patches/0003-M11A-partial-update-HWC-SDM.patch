+  const auto &roi = layers.left_frame_roi[0];
+  const bool full_frame = roi.left == 0 && roi.top == 0 &&
+                          roi.right == mixer.width && roi.bottom == mixer.height;
+  DRMRect connector = {0, 0, display.x_pixels, display.y_pixels};
+  if (!full_frame && (!panel.partial_update ||
