+++ b/core/java/android/os/HapticEngineConfig.java
@@ -0,0 +1,76 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package android.os;
+
+/**
+ * Immutable, versioned configuration shared by the haptic service and its settings UI.
+ * One Secure setting makes profile/strength updates atomic and keeps them per user.
+ * @hide
+ */
+public final class HapticEngineConfig {
+    public static final String SETTINGS_KEY = "mondrian_haptic_engine";
+    public static final int VERSION = 1;
+    public static final int SOFT = 0;
+    public static final int BALANCED = 1;
+    public static final int CRISP = 2;
+    public static final int DEFAULT_STRENGTH = 60;
+
+    // Private system haptic constants; these require VIBRATE_SYSTEM_CONSTANTS.
+    public static final int PREVIEW_CLICK = 20001;
+    public static final int PREVIEW_DOUBLE = 20002;
+    public static final int PREVIEW_STEPS = 20003;
+
+    public static final HapticEngineConfig DEFAULT =
+            new HapticEngineConfig(false, BALANCED, DEFAULT_STRENGTH);
+    public final boolean enabled;
+    public final int profile;
+    public final int strength;
+
+    public HapticEngineConfig(boolean enabled, int profile, int strength) {
+        this.enabled = enabled;
+        this.profile = profile >= SOFT && profile <= CRISP ? profile : BALANCED;
+        this.strength = Math.max(0, Math.min(100, strength));
+    }
+
+    public static HapticEngineConfig parse(String value) {
+        if (value == null || value.length() > 64) return DEFAULT;
+        String[] fields = value.split(":", -1);
+        if (fields.length != 4) return DEFAULT;
+        try {
+            if (Integer.parseInt(fields[0]) != VERSION) return DEFAULT;
+            int enabled = Integer.parseInt(fields[1]);
+            if (enabled != 0 && enabled != 1) return DEFAULT;
+            return new HapticEngineConfig(enabled == 1,
+                    Integer.parseInt(fields[2]), Integer.parseInt(fields[3]));
+        } catch (NumberFormatException e) {
+            return DEFAULT;
+        }
+    }
+
+    public static boolean isPreview(int constant) {
+        return constant >= PREVIEW_CLICK && constant <= PREVIEW_STEPS;
+    }
+
+    /** Software gain, not a claim about the motor's measured acceleration. */
+    public float gain() {
+        return (float) Math.pow(strength / 100.0, 1.35);
+    }
+
+    @Override
+    public String toString() {
+        return VERSION + ":" + (enabled ? 1 : 0) + ":" + profile + ":" + strength;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        return other instanceof HapticEngineConfig config && enabled == config.enabled
+                && profile == config.profile && strength == config.strength;
+    }
+
+    @Override
+    public int hashCode() {
+        return ((enabled ? 1 : 0) * 31 + profile) * 31 + strength;
+    }
+}
