diff --git a/services/core/java/com/android/server/vibrator/HapticProfileEngine.java b/services/core/java/com/android/server/vibrator/HapticProfileEngine.java
new file mode 100644
index 000000000..95e446d83
--- /dev/null
+++ b/services/core/java/com/android/server/vibrator/HapticProfileEngine.java
@@ -0,0 +1,137 @@
+/*
+ * Copyright (C) 2026 The Android Open Source Project
+ * SPDX-License-Identifier: Apache-2.0
+ */
+package com.android.server.vibrator;
+
+import static android.os.VibrationEffect.Composition.*;
+import static android.view.HapticFeedbackConstants.*;
+
+import android.annotation.Nullable;
+import android.os.HapticEngineConfig;
+import android.os.VibrationAttributes;
+import android.os.VibrationEffect;
+import android.os.VibratorInfo;
+
+/** Maps semantic touch feedback to the device's existing RTP primitives. */
+final class HapticProfileEngine {
+    private static final int TICK = 1, FREQUENT = 2, CLICK = 3, HEAVY = 4;
+    private static final int RISE = 5, FALL = 6, DOUBLE = 7, STEPS = 8;
+    private static final Recipe[][] RECIPES = createRecipes();
+    private static final Result MUTED = new Result(null);
+    private final Result[] mCache = new Result[9];
+    private final boolean[] mCached = new boolean[9];
+    private HapticEngineConfig mCachedConfig;
+    private final VibratorInfo mInfo;
+    private final boolean mSupported;
+
+    HapticProfileEngine(VibratorInfo info, boolean supported) {
+        mInfo = info;
+        mSupported = supported;
+    }
+
+    /** A null effect explicitly mutes a handled event; a null Result requests stock fallback. */
+    static final class Result {
+        @Nullable final VibrationEffect effect;
+        Result(@Nullable VibrationEffect effect) { this.effect = effect; }
+    }
+
+    @Nullable
+    synchronized Result resolve(int constant, int usage, HapticEngineConfig config) {
+        if (!mSupported || !config.enabled) return null;
+        if (usage != VibrationAttributes.USAGE_TOUCH
+                && !(usage == VibrationAttributes.USAGE_HARDWARE_FEEDBACK
+                && (constant == SCROLL_TICK || constant == SCROLL_ITEM_FOCUS
+                || constant == SCROLL_LIMIT))) return null;
+        int kind = kindOf(constant);
+        if (kind == 0) return null;
+        if (config.strength == 0) return MUTED;
+        if (!config.equals(mCachedConfig)) {
+            java.util.Arrays.fill(mCached, false);
+            java.util.Arrays.fill(mCache, null);
+            mCachedConfig = config;
+        }
+        if (mCached[kind]) return mCache[kind];
+        mCached[kind] = true;
+        Recipe recipe = RECIPES[config.profile][kind];
+        if (mInfo.getCompositionSizeMax() > 0
+                && mInfo.getCompositionSizeMax() < recipe.primitives.length) return null;
+        for (int delay : recipe.delays) {
+            if (mInfo.getPrimitiveDelayMax() > 0 && delay > mInfo.getPrimitiveDelayMax()) return null;
+        }
+        for (int primitive : recipe.primitives) {
+            if (!mInfo.isPrimitiveSupported(primitive)) return null;
+        }
+        VibrationEffect.Composition composition = VibrationEffect.startComposition();
+        float gain = config.gain();
+        for (int i = 0; i < recipe.primitives.length; i++) {
+            composition.addPrimitive(recipe.primitives[i], recipe.scales[i] * gain,
+                    recipe.delays[i]);
+        }
+        return mCache[kind] = new Result(composition.compose());
+    }
+
+    private static Recipe[][] createRecipes() {
+        Recipe[][] recipes = new Recipe[3][9];
+        for (int profile = 0; profile < recipes.length; profile++) {
+            for (int kind = 1; kind < recipes[profile].length; kind++) {
+                recipes[profile][kind] = recipeFor(kind, profile);
+            }
+        }
+        return recipes;
+    }
+
+    private static int kindOf(int constant) {
+        return switch (constant) {
+            case TEXT_HANDLE_MOVE, CLOCK_TICK, SEGMENT_FREQUENT_TICK, SCROLL_TICK -> FREQUENT;
+            case VIRTUAL_KEY_RELEASE, DRAG_CROSSING, SEGMENT_TICK, TOGGLE_OFF -> TICK;
+            case VIRTUAL_KEY, CONTEXT_CLICK, CONFIRM, GESTURE_START, GESTURE_END,
+                    SCROLL_ITEM_FOCUS, TOGGLE_ON, HapticEngineConfig.PREVIEW_CLICK -> CLICK;
+            case LONG_PRESS, DRAG_START, SCROLL_LIMIT -> HEAVY;
+            case GESTURE_THRESHOLD_ACTIVATE -> RISE;
+            case GESTURE_THRESHOLD_DEACTIVATE -> FALL;
+            case HapticEngineConfig.PREVIEW_DOUBLE -> DOUBLE;
+            case HapticEngineConfig.PREVIEW_STEPS -> STEPS;
+            default -> 0;
+        };
+    }
+
+    /** Initial conservative recipes; physical tuning is documented separately. */
+    private static Recipe recipeFor(int kind, int profile) {
+        boolean soft = profile == HapticEngineConfig.SOFT;
+        boolean crisp = profile == HapticEngineConfig.CRISP;
+        int tick = soft ? PRIMITIVE_LOW_TICK : PRIMITIVE_TICK;
+        int click = soft ? PRIMITIVE_LOW_TICK : PRIMITIVE_CLICK;
+        float clickScale = soft ? .76f : crisp ? .94f : .84f;
+        float tickScale = soft ? .46f : crisp ? .72f : .58f;
+        return switch (kind) {
+            case FREQUENT -> one(tick, soft ? .25f : crisp ? .40f : .32f);
+            case TICK -> one(tick, tickScale);
+            case HEAVY -> soft ? one(PRIMITIVE_THUD, .64f)
+                    : crisp ? one(PRIMITIVE_CLICK, .98f)
+                    : sequence(new int[]{PRIMITIVE_THUD, PRIMITIVE_CLICK},
+                            new float[]{.72f, .30f}, new int[]{0, 8});
+            case RISE -> crisp ? one(PRIMITIVE_CLICK, .88f)
+                    : sequence(new int[]{PRIMITIVE_QUICK_RISE, click},
+                            new float[]{soft ? .36f : .54f, clickScale * .45f},
+                            new int[]{0, 0});
+            case FALL -> crisp ? one(PRIMITIVE_TICK, .62f)
+                    : one(PRIMITIVE_QUICK_FALL, soft ? .35f : .50f);
+            case DOUBLE -> sequence(new int[]{click, click},
+                    new float[]{clickScale, clickScale * .75f}, new int[]{0, 55});
+            case STEPS -> sequence(new int[]{tick, tick, tick},
+                    new float[]{tickScale, tickScale, tickScale}, new int[]{0, 75, 75});
+            default -> one(click, clickScale);
+        };
+    }
+
+    private static Recipe one(int primitive, float scale) {
+        return sequence(new int[]{primitive}, new float[]{scale}, new int[]{0});
+    }
+
+    private static Recipe sequence(int[] primitives, float[] scales, int[] delays) {
+        return new Recipe(primitives, scales, delays);
+    }
+
+    private record Recipe(int[] primitives, float[] scales, int[] delays) {}
+}
