+            if (!isRecipeSupported(recipe)) return null;
+            return new Result(composeRecipe(recipe, config.gain()));
+        }
+
+        float gain = config.gain() * directProfileGain(config.profile);
+        ArrayList<VibrationEffectSegment> adapted = new ArrayList<>(segments.size());
