+                int primitiveId = remapDirectPrimitive(
+                        primitive.getPrimitiveId(), config.profile);
+                if (!mInfo.isPrimitiveSupported(primitiveId)) {
+                    primitiveId = primitive.getPrimitiveId();
+                }
+                if (!mInfo.isPrimitiveSupported(primitiveId)) return null;
+                adapted.add(new PrimitiveSegment(
+                        primitiveId,
+                        VibrationEffect.scale(primitive.getScale(), gain),
+                        primitive.getDelay(),
+                        primitive.getDelayType()));
+            } else {
+                adapted.add(segment.scale(gain));
+            }
+        }
+        VibrationEffect adaptedEffect = new VibrationEffect.Composed(adapted, -1);
+        adaptedEffect.validate();
+        return new Result(adaptedEffect);
+    }
