+    @Nullable
+    synchronized Result resolveDirectTouch(VibrationEffect effect, HapticEngineConfig config) {
+        if (!mSupported || !config.enabled || !effect.isHapticFeedbackCandidate()) return null;
+        if (config.strength == 0) return MUTED;
+        if (!(effect instanceof VibrationEffect.Composed composed)
+                || composed.getRepeatIndex() >= 0) return null;
+
+        List<VibrationEffectSegment> segments = composed.getSegments();
+        if (segments.isEmpty()) return null;
+
+        if (segments.size() == 1 && segments.get(0) instanceof PrebakedSegment prebaked) {
+            int kind = kindOfPrebaked(prebaked.getEffectId());
+            if (kind == 0) return null;
