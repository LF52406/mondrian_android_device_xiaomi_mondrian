+    private int kindOfPrebaked(int effectId) {
+        return switch (effectId) {
+            case VibrationEffect.EFFECT_TICK, VibrationEffect.EFFECT_TEXTURE_TICK -> TICK;
+            case VibrationEffect.EFFECT_HEAVY_CLICK, VibrationEffect.EFFECT_THUD -> HEAVY;
+            case VibrationEffect.EFFECT_DOUBLE_CLICK -> DOUBLE;
+            case VibrationEffect.EFFECT_CLICK, VibrationEffect.EFFECT_POP -> CLICK;
+            default -> 0;
+        };
+    }
+
+    private boolean isRecipeSupported(Recipe recipe) {
+        if (mInfo.getCompositionSizeMax() > 0
+                && mInfo.getCompositionSizeMax() < recipe.primitives.length) return false;
+        for (int delay : recipe.delays) {
+            if (mInfo.getPrimitiveDelayMax() > 0 && delay > mInfo.getPrimitiveDelayMax()) {
+                return false;
+            }
+        }
+        for (int primitive : recipe.primitives) {
+            if (!mInfo.isPrimitiveSupported(primitive)) return false;
+        }
+        return true;
+    }
+
+    private static VibrationEffect composeRecipe(Recipe recipe, float gain) {
+        VibrationEffect.Composition composition = VibrationEffect.startComposition();
+        for (int i = 0; i < recipe.primitives.length; i++) {
+            composition.addPrimitive(
+                    recipe.primitives[i], recipe.scales[i] * gain, recipe.delays[i]);
+        }
+        return composition.compose();
+    }
+
+    private static float directProfileGain(int profile) {
+        return switch (profile) {
+            case HapticEngineConfig.SOFT -> .88f;
+            case HapticEngineConfig.CRISP -> 1.05f;
+            default -> 1.0f;
+        };
+    }
+
+    private static int remapDirectPrimitive(int primitive, int profile) {
+        if (profile == HapticEngineConfig.SOFT) {
+            return switch (primitive) {
+                case PRIMITIVE_CLICK, PRIMITIVE_TICK -> PRIMITIVE_LOW_TICK;
+                default -> primitive;
+            };
+        }
+        if (profile == HapticEngineConfig.CRISP) {
+            return switch (primitive) {
+                case PRIMITIVE_LOW_TICK -> PRIMITIVE_TICK;
+                case PRIMITIVE_THUD -> PRIMITIVE_CLICK;
+                default -> primitive;
+            };
+        }
+        return primitive;
+    }
